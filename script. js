// ======================================
// LOAN APPLICATION SYSTEM
// Interest Rate: 8%
// Minimum Loan: $100
// Maximum Loan: $10,000
// ======================================

const INTEREST_RATE = 0.08;
const MIN_LOAN = 100;
const MAX_LOAN = 10000;

// GET HTML ELEMENTS
const amountInput = document.getElementById("amount");
const principalDisplay = document.getElementById("principal");
const interestDisplay = document.getElementById("interest");
const totalDisplay = document.getElementById("total");
const loanForm = document.getElementById("loanForm");
const messageDisplay = document.getElementById("message");

// FORMAT CURRENCY
function formatCurrency(amount) {
    return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD"
    }).format(amount);
}

// ======================================
// AUTOMATIC LOAN CALCULATOR
// ======================================

function calculateLoan() {

    const amount = Number(amountInput.value);

    if (!Number.isFinite(amount) || amount <= 0) {
        principalDisplay.textContent = "$0.00";
        interestDisplay.textContent = "$0.00";
        totalDisplay.textContent = "$0.00";
        return;
    }

    const interest = amount * INTEREST_RATE;
    const repayment = amount + interest;

    principalDisplay.textContent = formatCurrency(amount);
    interestDisplay.textContent = formatCurrency(interest);
    totalDisplay.textContent = formatCurrency(repayment);
}

// UPDATE CALCULATOR WHEN AMOUNT CHANGES
amountInput.addEventListener("input", calculateLoan);

// ======================================
// LOAN APPLICATION VALIDATION
// ======================================

loanForm.addEventListener("submit", function(event) {

    event.preventDefault();

    const fullName = document.getElementById("name").value.trim();
    const email = document.getElementById("email").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const country = document.getElementById("country").value.trim();
    const occupation = document.getElementById("occupation").value.trim();

    const amount = Number(amountInput.value);

    // CHECK REQUIRED DETAILS

    if (!fullName || !email || !phone || !country || !occupation) {
        alert("Please complete all required application fields.");
        return;
    }

    // CHECK LOAN LIMITS

    if (!Number.isFinite(amount) ||
        amount < MIN_LOAN ||
        amount > MAX_LOAN) {

        alert(
            "Loan applications must be between $100 and $10,000."
        );

        amountInput.focus();
        return;
    }

    // CALCULATE INTEREST

    const interest = amount * INTEREST_RATE;
    const totalRepayment = amount + interest;

    // APPLICATION REFERENCE

    const reference = "LN" +
        Date.now().toString().slice(-8);

    // DISPLAY APPLICATION SUMMARY

    messageDisplay.innerHTML = `
        <div style="
            background:#e8f7ef;
            border:1px solid #b5e2c9;
            padding:20px;
            border-radius:10px;
            margin-top:20px;
        ">

        <h3 style="color:#087443;">
            Application Details Validated
        </h3>

        <p><strong>Applicant:</strong> ${escapeHTML(fullName)}</p>

        <p><strong>Reference:</strong> ${reference}</p>

        <p><strong>Requested Loan:</strong>
        ${formatCurrency(amount)}</p>

        <p><strong>Interest (8%):</strong>
        ${formatCurrency(interest)}</p>

        <p><strong>Total Repayment:</strong>
        ${formatCurrency(totalRepayment)}</p>

        <p style="margin-top:12px;color:#087443;">
        Your application details have been validated.
        They have not yet been submitted to a lender.
        </p>

        </div>
    `;

});

// ======================================
// HTML SAFETY FUNCTION
// ======================================

function escapeHTML(value) {

    return value.replace(/[&<>"']/g, function(character) {

        const characters = {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#039;"
        };

        return characters[character];

    });

}

// ======================================
// END OF LOAN APPLICATION SYSTEM
// ======================================
